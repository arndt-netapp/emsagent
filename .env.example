# Required for the agentic analysis endpoints only; ingestion, parsing and the
# rest of the web UI work fine without it.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# NOTE: cost estimates and the per-investigation dollar cap are hardcoded to
# Claude Sonnet 5 rates in app/agent/pricing.py. Changing CLAUDE_MODEL does not
# update them, so both the reported cost and the cap will be wrong until you do.
CLAUDE_MODEL=claude-sonnet-5
EMS_WATCH_DIR=./data/logs_incoming
DATABASE_PATH=./data/emsagent.db
MAX_AGENT_ITERATIONS=15

# Reasoning effort per stage: low | medium | high | xhigh | max. Thinking tokens
# bill at the output rate, so these directly drive cost. Raise if analysis
# quality suffers; the API default (high) is more than either stage needs.
STAGE1_EFFORT=medium
STAGE2_EFFORT=low

# Used only by scripts/fetch_ems_events.py; never persisted anywhere.
# EMS_CLUSTER_USER=admin
# EMS_CLUSTER_PASSWORD=

# --- Live cluster state (optional) ---
# Lets the Stage 2 agent read what's true on the cluster RIGHT NOW (aggregate
# capacity, disk health, HA takeover status, volume state) to corroborate or
# refute what the logs suggest. Leave unset and the agent works from logs
# alone — its get_cluster_state tool just reports itself unavailable.
#
# ONE credential pair is used for EVERY cluster the agent is asked about. This
# is a PoC simplification: it assumes all reachable clusters accept the same
# login, and it is why these can sit in .env at all. Unlike the ingestion fetch
# form (where a human types a password for one request), investigations run as
# background tasks with nobody to prompt, so the credential must come from here.
#
# There is no host setting: which cluster to query is never configuration. Each
# analysis run is scoped to one cluster, and that cluster value is the host its
# events were fetched from, so an investigation always queries the cluster its
# own evidence came from.
# ONTAP_USER=admin
# ONTAP_PASSWORD=
# ONTAP_VERIFY_TLS=false
# ONTAP_TIMEOUT_SECONDS=15
